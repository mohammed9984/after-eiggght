# Copy to .env (or set these in your host's environment settings) and restart.
# Required for the owner dashboard to exist at all. No default password is ever created.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-this-to-a-long-passphrase

# Public address customers reach the site on. Printed table QR codes point here.
# Must be your real https:// domain in production.
BASE_URL=https://menu.example.com

# Optional
PORT=3000
DATA_DIR=./data            # SQLite lives here. On a host, mount a PERSISTENT volume at this path.
# SESSION_SECRET=          # Optional. If unset, a random secret is generated once and stored in the database.
